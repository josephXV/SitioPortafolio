meta {
  name: Proyectos finalizados
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/proyectos?estado=Finalizado
  body: none
  auth: none
}

params:query {
  estado: Finalizado
}

tests {
  // El parámetro ?estado=Finalizado hace que la API filtre los proyectos.
  test("Responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Todos los resultados tienen estado Finalizado", function () {
    const proyectos = res.getBody();

    // Debe devolver al menos un proyecto finalizado.
    expect(proyectos).to.be.an("array").that.is.not.empty;

    // Ningún proyecto de la respuesta puede tener otro estado.
    for (const proyecto of proyectos) {
      expect(proyecto.estado).to.equal("Finalizado");
    }
  });
}
