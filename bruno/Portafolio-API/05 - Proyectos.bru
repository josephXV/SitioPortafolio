meta {
  name: Proyectos
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/proyectos
  body: none
  auth: none
}

tests {
  // La ruta /proyectos pide la lista completa de proyectos.
  test("Responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Cada proyecto tiene nombre, descripcion, tecnologias y estado", function () {
    const proyectos = res.getBody();

    // La respuesta debe ser una lista con al menos un proyecto.
    expect(proyectos).to.be.an("array").that.is.not.empty;

    // Revisamos en cada proyecto los campos que usa la tarjeta.
    for (const proyecto of proyectos) {
      expect(proyecto).to.have.property("nombre");
      expect(proyecto).to.have.property("descripcion");
      expect(proyecto).to.have.property("estado");
      // Las tecnologías deben venir como arreglo para crear una etiqueta por cada una.
      expect(proyecto.tecnologias).to.be.an("array");
    }
  });
}
