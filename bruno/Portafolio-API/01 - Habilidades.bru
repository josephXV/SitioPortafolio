meta {
  name: Habilidades
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/habilidades
  body: none
  auth: none
}

tests {
  // La ruta /habilidades pide la lista completa.
  // El código 200 indica que la solicitud fue exitosa.
  test("Responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Devuelve una lista de habilidades", function () {
    // Leemos el cuerpo de la respuesta.
    const habilidades = res.getBody();

    // La lista debe ser un arreglo y tener al menos un registro.
    expect(habilidades).to.be.an("array").that.is.not.empty;

    // Revisamos en cada registro los tres campos que usa la tarjeta.
    for (const habilidad of habilidades) {
      expect(habilidad).to.have.property("nombre");
      expect(habilidad).to.have.property("nivel");
      expect(habilidad).to.have.property("categoria");
    }
  });
}